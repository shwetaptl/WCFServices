<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="SOAPEndPoint" />
      </basicHttpBinding>
    </bindings>
    <client>
      <!-- basicHttpBinding endpoint matches the service's Web.config binding -->
      <endpoint address="http://localhost:50095/SOAPService.svc/soap"
                binding="basicHttpBinding"
                bindingConfiguration="SOAPEndPoint"
                contract="SOAPService.ISOAPService"
                name="SOAPEndPoint" />
    </client>
  </system.serviceModel>
</configuration>
